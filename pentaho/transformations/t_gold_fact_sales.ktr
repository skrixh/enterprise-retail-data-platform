  <step>
    <name>Read silver sales</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>erdp_pg</connection>
    <sql>SELECT COALESCE(dd.date_key, -1)      AS date_key,
       COALESCE(dc.customer_key, -1)  AS customer_key,
       COALESCE(dp.product_key, -1)   AS product_key,
       CAST(1 AS SMALLINT)            AS channel_key,
       s.invoice_no                   AS transaction_ref,
       s.invoice_date                 AS sale_timestamp,
       s.country, s.quantity, s.unit_price, s.line_amount,
       s.is_cancelled, s.is_return, s.is_zero_price,
       'POS'                          AS source_system,
       s.pos_line_id                  AS source_line_id
FROM silver.sales_pos s
LEFT JOIN gold.dim_date     dd ON dd.full_date   = s.sale_date
LEFT JOIN gold.dim_customer dc ON dc.customer_id = s.customer_id
LEFT JOIN gold.dim_product  dp ON dp.product_id  = s.product_id
UNION ALL
SELECT COALESCE(dd.date_key, -1),
       COALESCE(dc.customer_key, -1),
       COALESCE(dp.product_key, -1),
       CAST(2 AS SMALLINT),
       s.order_id,
       s.order_date,
       s.country, s.quantity, s.unit_price, s.line_amount,
       s.is_cancelled, s.is_return, s.is_zero_price,
       'E-Commerce',
       s.ecom_line_id
FROM silver.sales_ecommerce s
LEFT JOIN gold.dim_date     dd ON dd.full_date   = s.sale_date
LEFT JOIN gold.dim_customer dc ON dc.customer_id = s.customer_id
LEFT JOIN gold.dim_product  dp ON dp.product_id  = s.product_id</sql>
    <limit>0</limit>
