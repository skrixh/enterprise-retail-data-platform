  <order>
    <hop>
      <from>Read silver supplier orders</from>
      <to>Write gold.dim_product</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Read silver supplier orders</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>erdp_pg</connection>
    <sql>SELECT s.purchase_order_id,
       COALESCE(ds.supplier_key, -1)  AS supplier_key,
       COALESCE(dp.product_key, -1)   AS product_key,
       COALESCE(d1.date_key, -1)      AS order_date_key,
       COALESCE(d2.date_key, -1)      AS expected_delivery_date_key,
       s.quantity,
       s.unit_cost,
       s.total_cost,
       s.expected_lead_time_days,
       s.order_status
FROM silver.supplier_orders s
LEFT JOIN gold.dim_supplier ds ON ds.supplier_id = s.supplier_id
LEFT JOIN gold.dim_product  dp ON dp.product_id  = s.product_id
LEFT JOIN gold.dim_date     d1 ON d1.full_date   = s.order_date
LEFT JOIN gold.dim_date     d2 ON d2.full_date   = s.expected_delivery_date</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
